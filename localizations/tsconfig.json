{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["*.ts"],
  "exclude": ["localizationScripts/*.ts"]
}
